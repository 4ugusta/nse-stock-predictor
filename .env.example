# Indian Stock Predictor - Environment Variables

# ============================================
# Anthropic API Key (Required for AI-powered analysis)
# Get your key at: https://console.anthropic.com/
# ============================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================
# Zerodha Kite Connect (Optional - for real-time data)
# ============================================
KITE_API_KEY=your_api_key
KITE_API_SECRET=your_api_secret
KITE_USER_ID=your_user_id
KITE_PASSWORD=your_password
KITE_TOTP_KEY=your_totp_secret
KITE_REDIRECT_URL=http://localhost:8000/callback

# ============================================
# Application Settings
# ============================================
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_DATA_DIR=./data
APP_CACHE_TTL_MINUTES=5

# ============================================
# Yahoo Finance Settings
# ============================================
YAHOO_RATE_LIMIT_PER_MINUTE=60
YAHOO_TIMEOUT_SECONDS=30

# ============================================
# News Settings
# ============================================
NEWS_CACHE_TTL_MINUTES=15
NEWS_MAX_ARTICLES_PER_SOURCE=20
